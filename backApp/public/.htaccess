<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. SI l'URL commence par api ou sanctum, on FORCE Apache à l'envoyer vers l'index.php de Laravel
    RewriteRule ^(sanctum|api)(.*)$ index.php [L]

    # 2. SINON, si ce n'est pas un fichier ou un dossier réel, on donne la main au index.html d'Angular
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
