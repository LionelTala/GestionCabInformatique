<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ✅ 1. Routes Laravel explicites → index.php
    RewriteRule ^(api|sanctum|verify-document)(/.*)?$ index.php [L]

    # ✅ 2. Si fichier/dossier physique existe → servir direct
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ✅ 3. Fallback Angular
    RewriteRule . /index.html [L]
</IfModule>